# Claude (캡션·기획 생성)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Gemini (이미지 생성) - Google AI Studio에서 발급
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Instagram (Instagram 로그인 방식 API, 홍보 전용 계정)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0

# 이미지 공개 URL용 S3 호환 스토리지 (Cloudflare R2 등)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 선택: 렌더링에 쓸 Chromium 경로 (Playwright 기본 브라우저가 없을 때)
CHROMIUM_EXECUTABLE=
GITHUB_TOKEN=
OUTPUT_DIR=
